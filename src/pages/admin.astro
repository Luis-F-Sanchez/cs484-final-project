---
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../convex/_generated/api";

const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const inStockItems = await convex.query(api.inStock.list);
const requestedItems = await convex.query(api.requestedItems.list);
const submissions = await convex.query(api.submissions.list);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Admin Panel - Food Coop</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
      }
      nav {
        margin-bottom: 20px;
        padding: 10px;
        background: #f0f0f0;
      }
      nav a {
        margin-right: 15px;
        text-decoration: none;
        color: #0066cc;
      }
      .section {
        margin-bottom: 40px;
        padding: 20px;
        background: #f9f9f9;
        border-radius: 8px;
      }
      .form-group {
        margin-bottom: 15px;
      }
      label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
      }
      input,
      select {
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
        margin-right: 10px;
      }
      button {
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
      }
      .add-btn {
        background: #2a9d2a;
        color: white;
      }
      .delete-btn {
        background: #dc3545;
        color: white;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      th,
      td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #ddd;
      }
      th {
        background: #e0e0e0;
        font-weight: bold;
      }
      .message {
        padding: 10px;
        margin-top: 10px;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <h1>🔧 Admin Panel</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/contribute">Submit a Contribution</a>
      <a href="/admin">Admin Panel</a>
      <a href="/wallet">My Wallet</a>
      <a href="/contact">Contact Administrator</a>
    </nav>

    <div class="section">
      <h2>Add New In-Stock Item</h2>
      <form id="add-stock-form">
        <div class="form-group">
          <label>Item Name:</label>
          <input
            type="text"
            name="itemName"
            required
            placeholder="e.g., Clif Bars"
          />
        </div>
        <div class="form-group">
          <label>Quantity:</label>
          <input
            type="number"
            name="stockRemaining"
            min="0"
            required
            placeholder="0"
          />
        </div>
        <div class="form-group">
          <label>Price ($):</label>
          <input
            type="number"
            name="price"
            step="0.01"
            min="0"
            required
            placeholder="0.00"
          />
        </div>
        <div class="form-group">
          <label>Costco Link:</label>
          <input type="url" name="link" placeholder="https://..." />
        </div>
        <button type="submit" class="add-btn">Add Item</button>
      </form>
      <div id="stock-message" class="message"></div>
    </div>

    <div class="section">
      <h2>Manage In-Stock Items</h2>
      <table>
        <thead>
          <tr>
            <th>Item Name</th>
            <th>Stock</th>
            <th>Price</th>
            <th>Link</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {
            inStockItems.map((item: any) => (
              <tr>
                <td>{item.itemName}</td>
                <td>{item.stockRemaining}</td>
                <td>${item.price.toFixed(2)}</td>
                <td>
                  {item.link ? (
                    <a href={item.link} target="_blank">
                      View
                    </a>
                  ) : (
                    "N/A"
                  )}
                </td>
                <td>
                  <button
                    class="delete-btn"
                    onclick={`deleteStockItem('${item._id}')`}
                  >
                    Delete
                  </button>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="section">
      <h2>Add New Most Requested Item</h2>
      <form id="add-requested-form">
        <div class="form-group">
          <label>Item Name:</label>
          <input
            type="text"
            name="itemName"
            required
            placeholder="e.g., Kirkland Protein Bars"
          />
        </div>
        <div class="form-group">
          <label>Costco Link:</label>
          <input type="url" name="link" required placeholder="https://..." />
        </div>
        <button type="submit" class="add-btn">Add Item</button>
      </form>
      <div id="requested-message" class="message"></div>
    </div>

    <div class="section">
      <h2>Manage Most Requested Items</h2>
      <table>
        <thead>
          <tr>
            <th>Item Name</th>
            <th>Upvotes</th>
            <th>Downvotes</th>
            <th>Net Votes</th>
            <th>Link</th>
          </tr>
        </thead>
        <tbody>
          {
            requestedItems.map((item: any) => (
              <tr>
                <td>{item.itemName}</td>
                <td>{item.upvotes}</td>
                <td>{item.downvotes}</td>
                <td>{item.upvotes - item.downvotes}</td>
                <td>
                  <a href={item.link} target="_blank">
                    View
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="section">
      <h2>Submitted Links for Review</h2>
      <table>
        <thead>
          <tr>
            <th>Submitted Link</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {
            submissions.map((sub: any) => (
              <tr>
                <td>
                  <a href={sub.content} target="_blank">
                    {sub.content}
                  </a>
                </td>
                <td>
                  <button
                    class="add-btn"
                    onclick={`approveSubmission('${sub._id}', '${sub.content}')`}
                  >
                    Approve
                  </button>
                </td>
              </tr>
            ))
          }
          {
            submissions.length === 0 && (
              <tr>
                <td colspan="2">No submissions pending review.</td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>

    <script>
      import { ConvexHttpClient } from "convex/browser";
      import { api } from "../../convex/_generated/api";
      import type { Id } from "../../convex/_generated/dataModel";

      const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

      const stockForm = document.getElementById("add-stock-form");
      const stockMessage = document.getElementById("stock-message");

      if (stockForm && stockMessage) {
        stockForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const target = e.target as HTMLFormElement;
          const formData = new FormData(target);

          const itemName = formData.get("itemName");
          const stockRemaining = formData.get("stockRemaining");
          const price = formData.get("price");
          const link = formData.get("link");

          if (
            typeof itemName !== "string" ||
            typeof stockRemaining !== "string" ||
            typeof price !== "string" ||
            (link !== null && typeof link !== "string")
          ) {
            stockMessage.textContent = "✗ Invalid form data";
            stockMessage.style.backgroundColor = "#f8d7da";
            stockMessage.style.color = "#721c24";
            return;
          }

          try {
            await convex.mutation(api.inStock.create, {
              itemName: itemName,
              stockRemaining: Number(stockRemaining),
              price: Number(price),
              link: link || "",
            });

            stockMessage.textContent = "✓ Item added successfully!";
            stockMessage.style.backgroundColor = "#d4edda";
            stockMessage.style.color = "#155724";
            target.reset();

            setTimeout(() => location.reload(), 1000);
          } catch (error) {
            stockMessage.textContent = "✗ Error adding item.";
            stockMessage.style.backgroundColor = "#f8d7da";
            stockMessage.style.color = "#721c24";
          }
        });
      }

      const requestedForm = document.getElementById("add-requested-form");
      const requestedMessage = document.getElementById("requested-message");

      if (requestedForm && requestedMessage) {
        requestedForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const target = e.target as HTMLFormElement;
          const formData = new FormData(target);

          const itemName = formData.get("itemName");
          const link = formData.get("link");

          if (typeof itemName !== "string" || typeof link !== "string") {
            requestedMessage.textContent = "✗ Invalid form data";
            requestedMessage.style.backgroundColor = "#f8d7da";
            requestedMessage.style.color = "#721c24";
            return;
          }

          try {
            await convex.mutation(api.requestedItems.create, {
              itemName: itemName,
              link: link,
            });

            requestedMessage.textContent = "✓ Item added successfully!";
            requestedMessage.style.backgroundColor = "#d4edda";
            requestedMessage.style.color = "#155724";
            target.reset();

            setTimeout(() => location.reload(), 1000);
          } catch (error) {
            requestedMessage.textContent = "✗ Error adding item.";
            requestedMessage.style.backgroundColor = "#f8d7da";
            requestedMessage.style.color = "#721c24";
          }
        });
      }

      declare global {
        interface Window {
          deleteStockItem: (id: string) => Promise<void>;
          approveSubmission: (id: string, link: string) => Promise<void>;
        }
      }

      window.deleteStockItem = async (id: string) => {
        if (confirm("Are you sure you want to delete this item?")) {
          await convex.mutation(api.inStock.remove, {
            id: id as Id<"inStock">,
          });
          location.reload();
        }
      };

      window.approveSubmission = async (id: string, link: string) => {
        const itemName = prompt("Enter item name for this Costco link:");
        if (itemName) {
          await convex.mutation(api.requestedItems.create, { itemName, link });
          alert("Submission approved and added to requested items!");
          location.reload();
        }
      };
    </script>
  </body>
</html>
