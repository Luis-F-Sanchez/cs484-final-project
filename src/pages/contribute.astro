---
import MainLayout from "./layouts/MainLayout.astro";
---

<MainLayout title="Food Coop - Submit a Contribution">
  <h2>Submit a Contribution</h2>
  <p>
    Use this form to add a new bulk item to the Food Coop. For now, this is just
    a static form — we'll wire it up later.
  </p>

  <form
    style="display: grid; gap: 0.75rem; max-width: 400px; margin-top: 1.5rem;"
  >
    <label style="display: grid; gap: 0.25rem;">
      <span>Item name</span>
      <input name="itemName" type="text" required />
    </label>

    <label style="display: grid; gap: 0.25rem;">
      <span>Quantity (number of units)</span>
      <input name="quantity" type="number" min="1" required />
    </label>

    <label style="display: grid; gap: 0.25rem;">
      <span>Per-unit price ($)</span>
      <input
        name="unitPrice"
        type="number"
        step="0.01"
        min="0"
        required
      />
    </label>

    <label style="display: grid; gap: 0.25rem;">
      <span>Reimbursement amount to add to wallet ($)</span>
      <input
        name="reimbursement"
        type="number"
        step="0.01"
        min="0"
        required
      />
    </label>

    <label style="display: grid; gap: 0.25rem;">
      <span>Costco link (optional)</span>
      <input name="costcoLink" type="url" placeholder="https://..." />
    </label>

    <button type="submit" style="margin-top: 0.5rem;">Submit Contribution</button>
  </form>
</MainLayout>
