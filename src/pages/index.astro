---
import MainLayout from "./layouts/MainLayout.astro";
import FakeStore from "./components/FakeStore.tsx";
---

<MainLayout title="Food Coop – Home">
  <h2>In Stock Items</h2>
  <p>
    Browse items currently available in the Food Coop. Click "Buy 1" to simulate a purchase
    and see your fake balance change.
  </p>

  <!-- React island: hydrates in the browser and manages its own state -->
  <FakeStore client:load />
</MainLayout>
