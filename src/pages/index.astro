---
import Layout from "../layouts/Layout.astro";
import HomeShell from "../components/HomeShell";
---

<!-- Imports the shared Layout and HomeShell -->
<!-- This file is responsible for rendering the home page -->

<Layout>
  <main class="mx-auto max-w-7xl px-6 py-8 min-h-screen">
    <div class="grid gap-6 lg:grid-cols-[200px_1fr_200px] items-stretch">

      <div class="hidden lg:block h-full">
        <div class="h-full rounded-lg border border-gray-200 bg-white p-4 shadow-sm text-center text-sm text-gray-500">
          Insert targeted advertising here
        </div>
      </div>

      <div class="w-full">
        <HomeShell client:load />
      </div>

      <div class="hidden lg:block h-full">
        <div class="h-full rounded-lg border border-gray-200 bg-white p-4 shadow-sm text-center text-sm text-gray-500">
          Insert targeted advertising here
        </div>
      </div>

    </div>
  </main>
</Layout>
