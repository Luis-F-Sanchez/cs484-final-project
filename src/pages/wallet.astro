---
import MainLayout from "./layouts/MainLayout.astro";
---

<MainLayout title="Food Coop - My Wallet">
  <h2>My Wallet</h2>
  <p>
    This page will eventually show the user's real balance, recent purchases, and
    other account details. For now, we're using placeholder values.
  </p>

  <section style="margin-top: 1.5rem;">
    <h3>Current Balance</h3>
    <p style="font-size: 1.25rem; font-weight: bold;">
      $10.00
    </p>
  </section>

  <section style="margin-top: 2rem;">
    <h3>Recent Purchases</h3>
    <ul>
      <li>Fruit Snacks - 2 units - $1.00</li>
      <li>Clif Bar - 1 unit - $1.50</li>
      <li>Gum - 3 units - $0.75</li>
    </ul>
  </section>
</MainLayout>
